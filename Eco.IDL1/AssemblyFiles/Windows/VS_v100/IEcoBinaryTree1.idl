interface IEcoBinaryTree1 : IEcoUnknown {

    voidptr_t CreateNode([in] voidptr_t data, [in] char_t* name);
    voidptr_t InsertNode([in] voidptr_t parent, [in] voidptr_t child);
    voidptr_t InsertNodeByData([in] voidptr_t parent, [in] voidptr_t data, [in] char_t* name);
    int16_t DeleteNode([in] voidptr_t node);
    int16_t Clear();
};