{
	"folders": [
		{ "path": ".", "name": "AssemblyFiles" },
		{ "path": "../../../BuildFiles", "name": "BuildFiles" },
		{ "path": "../../../DependenciesFiles" },
		{ "path": "../../../DesignFiles" },
		{ "path": "../../../HeaderFiles" },
		{ "path": "../../../SharedFiles" },
		{ "path": "../../../SourceFiles" },
		{ "path": "../../../UnitTestFiles" }
	],
	"settings": {
		"C_Cpp.default.configurationProvider": "ms-vscode.makefile-tools",
		"C_Cpp.default.cStandard": "c89",
		"C_Cpp.default.includePath": [
			"${workspaceFolder}/**",
			"**/../../HeaderFiles",
			"**/../../SharedFiles",
			"${ECO_FRAMEWORK}/Eco.Core1/SharedFiles",
			"${ECO_FRAMEWORK}/Eco.System1/SharedFiles",			
			"${ECO_FRAMEWORK}/Eco.InterfaceBus1/SharedFiles",
			"${ECO_FRAMEWORK}/Eco.MemoryManager1/SharedFiles",
			"${ECO_FRAMEWORK}/Eco.FileSystemManagement1/SharedFiles"
		],
		"makefile.configurations": [
			{ "name": "EcoIDL1CPP Static|x86 Debug", "makeArgs": ["TARGET=1", "ARCH=x86", "DEBUG=1"] },
			{ "name": "EcoIDL1CPP Static|x86 Release", "makeArgs": ["TARGET=1", "ARCH=x86", "DEBUG=0"] },
			{ "name": "EcoIDL1CPP Static|x64 Debug", "makeArgs": ["TARGET=1", "ARCH=x64", "DEBUG=1"] },
			{ "name": "EcoIDL1CPP Static|x64 Release", "makeArgs": ["TARGET=1", "ARCH=x64", "DEBUG=0"] },
			{ "name": "EcoIDL1CPP Dynamic|x86 Debug", "makeArgs": ["TARGET=0", "ARCH=x86", "DEBUG=1"] },
			{ "name": "EcoIDL1CPP Dynamic|x86 Release", "makeArgs": ["TARGET=0", "ARCH=x86", "DEBUG=0"] },
			{ "name": "EcoIDL1CPP Dynamic|x64 Debug", "makeArgs": ["TARGET=0", "ARCH=x64", "DEBUG=1"] },
			{ "name": "EcoIDL1CPP Dynamic|x64 Release", "makeArgs": ["TARGET=0", "ARCH=x64", "DEBUG=0"] },
			{ "name": "EcoIDL1CPPUnitTest Static|x86 Debug", "makeArgs": ["-f", "MakefileExe", "TARGET=1", "ARCH=x86", "DEBUG=1"] },
			{ "name": "EcoIDL1CPPUnitTest Static|x64 Debug", "makeArgs": ["-f", "MakefileExe", "TARGET=1", "ARCH=x64", "DEBUG=1"] }
			{ "name": "EcoIDL1CPPUnitTest Dynamic|x86 Debug", "makeArgs": ["-f", "MakefileExe", "TARGET=0", "ARCH=x86", "DEBUG=1"] },
			{ "name": "EcoIDL1CPPUnitTest Dynamic|x64 Debug", "makeArgs": ["-f", "MakefileExe", "TARGET=0", "ARCH=x64", "DEBUG=1"] }
		]
	},
	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"name": "DEBUG: EcoIDL1CPPUnitTest Static|x86",
				"type": "cppdbg",
				"request": "launch",
				"program": "${workspaceFolder:BuildFiles}/Linux/x86/StaticDebug/EcoIDL1CPP.exe",
				"cwd": "${workspaceFolder:BuildFiles}/Linux/x86/StaticDebug",
				"preLaunchTask": "build EcoIDL1CPPUnitTest StaticDebug|x86",
				"MIMode": "gdb",
				"miDebuggerPath": "${env:ECO_TOOLCHAIN}/eco-i686-win-dwarf-gcc-13.2.0-win-x86_64/bin/gdb.exe"
			},
			{
				"name": "DEBUG: EcoIDL1CPPUnitTest Static|x64",
				"type": "cppdbg",
				"request": "launch",
				"program": "${workspaceFolder:BuildFiles}/Linux/x64/StaticDebug/EcoIDL1CPP.exe",
				"cwd": "${workspaceFolder:BuildFiles}/Linux/x64/StaticDebug",
				"preLaunchTask": "build EcoIDL1CPPUnitTest StaticDebug|x64",
				"MIMode": "gdb",
				"miDebuggerPath": "${env:ECO_TOOLCHAIN}/eco-x86_64-win-dwarf-gcc-13.2.0-win-x86_64/bin/gdb.exe"
			},
			{
				"name": "DEBUG: EcoIDL1CPPUnitTest Dynamic|x86",
				"type": "cppdbg",
				"request": "launch",
				"program": "${workspaceFolder:BuildFiles}/Linux/x86/DynamicDebug/EcoIDL1CPP.exe",
				"cwd": "${workspaceFolder:BuildFiles}/Linux/x86/DynamicDebug",
				"preLaunchTask": "build EcoIDL1CPPUnitTest DynamicDebug|x86",
				"MIMode": "gdb",
				"miDebuggerPath": "${env:ECO_TOOLCHAIN}/eco-i686-win-dwarf-gcc-13.2.0-win-x86_64/bin/gdb.exe"
			},
			{
				"name": "DEBUG: EcoIDL1CPPUnitTest Dynamic|x64",
				"type": "cppdbg",
				"request": "launch",
				"program": "${workspaceFolder:BuildFiles}/Linux/x64/DynamicDebug/EcoIDL1CPP.exe",
				"cwd": "${workspaceFolder:BuildFiles}/Linux/x64/DynamicDebug",
				"preLaunchTask": "build EcoIDL1CPPUnitTest DynamicDebug|x64",
				"MIMode": "gdb",
				"miDebuggerPath": "gdb"
			}
		]
	},
	"tasks": {
		"version": "2.0.0",
		"tasks": [
			{
				"label": "build all configurations",
				"type": "shell",
				"command": "${workspaceFolder:AssemblyFiles}/build.bat",
				"group": { "kind": "build", "isDefault": true },
				"presentation": { "echo": true, "reveal": "always", "focus": false, "panel": "shared" },
				"problemMatcher": []
			},
			{
				"label": "build EcoIDL1CPP StaticDebug|x86",
				"type": "shell",
				"command": "make",
				"args": [ "-f", "Makefile", "TARGET=1", "DEBUG=1", "ARCH=x86" ],
				"group": "build",
				"presentation": { "echo": true, "reveal": "silent", "focus": false, "panel": "shared" },
				"problemMatcher": [ "$gcc" ]
			},
			{
				"label": "build EcoIDL1CPP StaticRelease|x86",
				"type": "shell",
				"command": "make",
				"args": [ "-f", "Makefile", "TARGET=1", "DEBUG=0", "ARCH=x86" ],
				"group": "build",
				"presentation": { "echo": true, "reveal": "silent", "focus": false, "panel": "shared" },			
				"problemMatcher": [ "$gcc" ]
			},
			{
				"label": "build EcoIDL1CPP DynamicDebug|x86",
				"type": "shell",
				"command": "make",
				"args": [ "-f", "Makefile", "TARGET=0", "DEBUG=1", "ARCH=x86" ],
				"group": "build",
				"presentation": { "echo": true, "reveal": "silent", "focus": false, "panel": "shared" },			
				"problemMatcher": [ "$gcc" ]
			},
			{
				"label": "build EcoIDL1CPP DynamicRelease|x86",
				"type": "shell",
				"command": "make",
				"args": [ "-f", "Makefile", "TARGET=0", "DEBUG=0", "ARCH=x86" ],
				"group": "build",
				"presentation": { "echo": true, "reveal": "silent", "focus": false, "panel": "shared" },			
				"problemMatcher": [ "$gcc" ]
			},
			{
				"label": "build EcoIDL1CPP StaticDebug|x64",
				"type": "shell",
				"command": "make",
				"args": [ "-f", "Makefile", "TARGET=1", "DEBUG=1", "ARCH=x64" ],
				"group": "build",
				"presentation": { "echo": true, "reveal": "silent", "focus": false, "panel": "shared" },		
				"problemMatcher": [ "$gcc" ]
			},
			{
				"label": "build EcoIDL1CPP StaticRelease|x64",
				"type": "shell",
				"command": "make",
				"args": [ "-f", "Makefile", "TARGET=1", "DEBUG=0", "ARCH=x64" ],
				"group": "build",
				"presentation": { "echo": true, "reveal": "silent", "focus": false, "panel": "shared" },			
				"problemMatcher": [ "$gcc" ]
			},
			{
				"label": "build EcoIDL1CPP DynamicDebug|x64",
				"type": "shell",
				"command": "make",
				"args": [ "-f", "Makefile", "TARGET=0", "DEBUG=1", "ARCH=x64" ],
				"group": "build",
				"presentation": { "echo": true, "reveal": "silent", "focus": false, "panel": "shared" },		
				"problemMatcher": [ "$gcc" ]
			},
			{
				"label": "build EcoIDL1CPP DynamicRelease|x64",
				"type": "shell",
				"command": "make",
				"args": [ "-f", "Makefile", "TARGET=0", "DEBUG=0", "ARCH=x64" ],
				"group": "build",
				"presentation": { "echo": true, "reveal": "silent", "focus": false, "panel": "shared" },			
				"problemMatcher": [ "$gcc" ]
			},
			{
				"label": "build EcoIDL1CPPUnitTest StaticDebug|x86",
				"type": "shell",
				"command": "make",
				"args": [ "-f", "MakefileExe", "TARGET=1", "DEBUG=1", "ARCH=x86" ],
				"group": "build",
				"dependsOn": ["build EcoIDL1CPP StaticDebug|x86"],			
				"problemMatcher": [ "$gcc" ]
			},
			{
				"label": "build EcoIDL1CPPUnitTest StaticRelease|x86",
				"type": "shell",
				"command": "make",
				"args": [ "-f", "MakefileExe", "TARGET=1", "DEBUG=0", "ARCH=x86" ],
				"group": "build",
				"dependsOn": ["build EcoIDL1CPP StaticRelease|x86"],			
				"problemMatcher": [ "$gcc" ]
			},
			{
				"label": "build EcoIDL1CPPUnitTest DynamicDebug|x86",
				"type": "shell",
				"command": "make",
				"args": ["-f", "MakefileExe", "TARGET=0", "DEBUG=1", "ARCH=x86" ],
				"group": "build",
				"dependsOn": ["build EcoIDL1CPP DynamicDebug|x86"],			
				"problemMatcher": [ "$gcc" ]
			},
			{
				"label": "build EcoIDL1CPPUnitTest DynamicRelease|x86",
				"type": "shell",
				"command": "make",
				"args": [ "-f", "MakefileExe", "TARGET=0", "DEBUG=0", "ARCH=x86" ],
				"group": "build",
				"dependsOn": ["build EcoIDL1CPP DynamicRelease|x86"],			
				"problemMatcher": [ "$gcc" ]
			},
			{
				"label": "build EcoIDL1CPPUnitTest StaticDebug|x64",
				"type": "shell",
				"command": "make",
				"args": [ "-f", "MakefileExe", "TARGET=1", "DEBUG=1", "ARCH=x64" ],
				"group": "build",
				"dependsOn": ["build EcoIDL1CPP StaticDebug|x64"],				
				"problemMatcher": [ "$gcc" ]
			},
			{
				"label": "build EcoIDL1CPPUnitTest StaticRelease|x64",
				"type": "shell",
				"command": "make",
				"args": [ "-f", "MakefileExe", "TARGET=1", "DEBUG=0", "ARCH=x64" ],
				"group": "build",
				"dependsOn": ["build EcoIDL1CPP StaticRelease|x64"],			
				"problemMatcher": [ "$gcc" ]
			},
			{
				"label": "build EcoIDL1CPPUnitTest DynamicDebug|x64",
				"type": "shell",
				"command": "make",
				"args": [ "-f", "MakefileExe", "TARGET=0", "DEBUG=1", "ARCH=x64" ],
				"group": "build",
				"dependsOn": ["build EcoIDL1CPP DynamicDebug|x64"],			
				"problemMatcher": [ "$gcc" ]
			},
			{
				"label": "build EcoIDL1CPPUnitTest DynamicRelease|x64",
				"type": "shell",
				"command": "make",
				"args": [ "-f", "MakefileExe", "TARGET=0", "DEBUG=0", "ARCH=x64" ],
				"group": "build",
				"dependsOn": ["build EcoIDL1CPP DynamicRelease|x64"],			
				"problemMatcher": [ "$gcc" ]
			},
			{
				"label": "Clean All",
				"type": "shell",
				"command": "make clean",
				"options": { "cwd": "${workspaceFolder:AssemblyFiles}" }
			}
		]
	}
}
